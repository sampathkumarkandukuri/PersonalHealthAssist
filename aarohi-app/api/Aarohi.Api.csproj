<Project Sdk="Microsoft.NET.Sdk.Web"><PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup><ItemGroup><PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" /><PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" /><PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" /></ItemGroup><Target Name="BuildFrontendAssets" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')"><Exec Command="npm ci --prefix ../web" Condition="Exists('$(MSBuildProjectDirectory)\..\web\package.json') and !Exists('$(MSBuildProjectDirectory)\..\web\node_modules')" /><Exec Command="npm run build --prefix ../web" Condition="Exists('$(MSBuildProjectDirectory)\..\web\package.json')" /></Target></Project>
